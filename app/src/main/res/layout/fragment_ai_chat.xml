<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Header Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="🤖"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asistente Virtual IA"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● En línea | Recomendaciones inteligentes"
                    android:textSize="12sp"
                    android:textColor="#2E7D32" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Suggestions horizontal scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:scrollbars="none"
        android:background="#EFEFEF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPantallas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="📺 Recomiéndame pantallas"
                app:chipBackgroundColor="?attr/colorSurface"
                style="@style/Widget.Material3.Chip.Suggestion" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLaptops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="💻 Laptops para trabajo"
                app:chipBackgroundColor="?attr/colorSurface"
                style="@style/Widget.Material3.Chip.Suggestion" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCelulares"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="📱 Smartphones 256GB"
                app:chipBackgroundColor="?attr/colorSurface"
                style="@style/Widget.Material3.Chip.Suggestion" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHogar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠 Productos para hogar"
                app:chipBackgroundColor="?attr/colorSurface"
                style="@style/Widget.Material3.Chip.Suggestion" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAiMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp"
        tools:listitem="@layout/item_ai_message_ai" />

    <!-- Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface">

        <EditText
            android:id="@+id/etAiMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Escribe tu consulta o pide recomendaciones..."
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="textCapSentences"
            android:maxLines="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendAi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Enviar"
            app:cornerRadius="20dp" />
    </LinearLayout>

</LinearLayout>
